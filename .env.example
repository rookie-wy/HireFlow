# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）
APP_ENV=development
DEBUG=True

# 密钥（务必改成随机值，可用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成）
# JWT_SECRET_KEY 启动时会校验：为空或等于 change-me 将拒绝启动
SECRET_KEY=
JWT_SECRET_KEY=

# 数据库（MySQL，与代码一致）
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/recruitment?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

# LLM（云端 DeepSeek）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LITELLM_MODEL=deepseek-chat
LITELLM_API_BASE=https://api.deepseek.com/v1
LLM_BACKUP_MODELS=["deepseek-chat"]

# 嵌入 / 重排
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
MAX_UPLOAD_SIZE=10485760

# 可观测（后置，先留空）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 限流
RATE_LIMIT_PER_MINUTE=100/minute
