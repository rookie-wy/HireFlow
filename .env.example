# =============================================================================
# AI 招聘 Agent 系统 — 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后修改下面所有标注「必须修改」的项，再执行：
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
#
# ⚠️ 安全提示（生产环境必读）
#   1. JWT_SECRET_KEY / AGENT_INTERNAL_KEY / MYSQL_ROOT_PASSWORD 三项
#      生产环境必须替换成本项目自己生成的高强度随机值，禁止沿用本文件的开发示例值。
#      生成方式（任选）：openssl rand -hex 32  或  python -c "import secrets;print(secrets.token_urlsafe(48))"
#   2. LLM_API_KEY 填你自己的 DeepSeek Key（https://platform.deepseek.com）。
#      本文件**不含任何真实密钥**，示例值一律为占位符。
#   3. backend 在 APP_ENV=production 时对 JWT_SECRET_KEY / AGENT_INTERNAL_KEY
#      做 fail-fast：没配就拒绝启动；agent 同理（还会校验 LLM_API_KEY）。
#   4. .env 不要提交到版本库（建议加进 .gitignore）；本项目的 .dockerignore 已排除它。
#   5. 下面出现的重复值不是笔误：
#      MYSQL_ROOT_PASSWORD 与 DATABASE_URL 里的密码必须一致 ——
#      MYSQL_ROOT_PASSWORD 是给 mysql 容器初始化用的，
#      DATABASE_URL 是给 backend 连接用的（compose 不做嵌套变量替换，故需手写两处）。
#
# 本机开发调试（不使用 Docker）时，只需复制需要的项到 backend/.env 与 agent/.env，
# 并把 DATABASE_URL 的 mysql:3306 / redis:6379 换成 localhost:13306 / localhost:6379。
# =============================================================================

# ------------------------------------------------------------------ 运行环境
# development | production；production 会开启密钥 fail-fast 并关闭一些调试输出
APP_ENV=production

# --------------------------------------------------------------- MySQL 8.0
# 容器初始化密码（必须修改）
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_DATABASE=recruitment
# 宿主映射端口：宿主 3306 常被本机 MySQL 占用，故默认 13306
MYSQL_PORT=13306

# --------------------------------------------------------------- Redis 7
# 仅映射宿主端口，容器内固定 redis:6379，无密码（单机开发用，勿暴露到公网）
REDIS_PORT=6379

# --------------------------------------------------------------- ChromaDB
# 镜像版本固定 chromadb/chroma:1.0.15（客户端 1.5.x 与 0.5.x 服务端 API 不兼容）
CHROMA_PORT=18001

# --------------------------------------------------------------- 服务端口（宿主映射）
BACKEND_PORT=8080
AGENT_PORT=8001
# frontend nginx：宿主 3000 → 容器 80（与开发环境 Vite dev 的 3000 对齐）
FRONTEND_PORT=3000

# --------------------------------------------------------------- 服务间密钥
# backend 与 agent 共用的内部调用密钥，两边必须一致（必须修改）
# 不一致的典型现象：agent 对 backend 的请求返回 401 invalid internal key
AGENT_INTERNAL_KEY=CHANGE_ME_internal_key_between_backend_and_agent

# --------------------------------------------------------------- JWT
# 必须修改；生产环境禁止使用示例值
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_at_least_32_chars
JWT_ISSUER=ai-recruitment-backend
JWT_EXPIRE_MINUTES=60

# --------------------------------------------------------------- 数据库（backend 用）
# 容器内拓扑：mysql:3306；本机开发改成 localhost:13306 并把密码改成实际值。
# 注意：compose 不会对内层变量做二次替换，这里的密码要与 MYSQL_ROOT_PASSWORD 保持一致。
DATABASE_URL=root:CHANGE_ME_mysql_root_password@tcp(mysql:3306)/recruitment?charset=utf8mb4&parseTime=True&loc=Local
# 容器内拓扑；本机开发改成 redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------- agent 地址（backend 用）
# 容器内拓扑；本机开发改成 http://localhost:8001
AGENT_BASE_URL=http://agent:8001

# --------------------------------------------------------------- LLM（DeepSeek，OpenAI 兼容）
# 必须修改：填自己的 DeepSeek Key
LLM_API_KEY=sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --------------------------------------------------------------- CORS
# 逗号分隔白名单。生产走 nginx 同源反代，通常只需保留前端访问地址；
# 直连 backend:8080 调试时可把本机地址一并加上。
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- 限流（每分钟，基于 Redis）
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_SCREEN_PER_MIN=5

# --------------------------------------------------------------- 上传与筛选
UPLOAD_MAX_MB=10
SCREEN_WORKER_COUNT=4
SCREEN_QUEUE_SIZE=64
# 单任务超时；agent 侧 HTTP 客户端超时 = 本值 + 30s（保证到点能切断 NDJSON 流）
SCREEN_TASK_TIMEOUT_SEC=300
# 每批送粗筛的候选人数（0=用默认页大小 200）。
# 大租户（几百到几千份简历）可调小，降低单批内存占用与单批耗时；粗筛结果会跨批合并后统一重排。
SCREEN_BATCH_SIZE=0

# --------------------------------------------------------------- 检索与重排（agent）
# 重排策略：cosine（默认，用常驻 BGE-M3 做向量余弦，约 30-80ms/对）
#           cross_encoder（BGE-reranker，精度略高但 CPU 上约 3s/对，建议有 GPU 时再用）
RERANK_MODE=cosine
# 送入重排的对数 = max_candidates × factor；单篇文档截断字符数（重排成本与长度强相关）
RERANK_PAIRS_FACTOR=2
RERANK_DOC_CHARS=400
# 余弦模式阈值（与 cross-encoder 的 0.4 不同量纲，故分模式配置）
RERANK_THRESHOLD_COSINE=0.55
# 嵌入截断长度：简历 chunk 为 500 字符，512 token 足够（避免默认 8192 的无谓 padding 计算）
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=8
# torch 线程数：多模型同进程时必须限制，否则 CPU 超订会把重排拖慢一个数量级
TORCH_NUM_THREADS=4
# 专家评估并发上限（保护上游 LLM 限流）
LLM_MAX_CONCURRENCY=4
# 启动后台预热嵌入模型（把首次请求的数十秒冷启动移出请求路径）
WARMUP_MODELS=true
# 简历向量化转后台任务（上传响应只等「文本提取 + LLM 抽取」；粗筛有 BM25 兜底）
VECTORIZE_IN_BACKGROUND=true
# 日志级别：生产务必 INFO；DEBUG 会把 httpx/httpcore/openai 的逐请求日志打满，
# 实测可把单次筛选从十几秒拖到百秒级
LOG_LEVEL=INFO

# --------------------------------------------------------------- 模型路径（agent）
# 这两个变量是**给容器用的**：容器内固定挂载点为 /app/models，所以路径写死即可。
# 本机开发时把它们注释掉 —— config.py 的 _prefer_local_models() 会按
# agent/models/ 目录自动探测本地权重（推荐路径，国内可规避 HF 镜像 403）。
# 探测条件：/app/models/bge-m3、/app/models/bge-reranker-v2-m3 下存在
# model.safetensors / pytorch_model.bin / model.safetensors.index.json 之一。
EMBEDDING_MODEL_PATH=/app/models/bge-m3
RERANKER_MODEL_PATH=/app/models/bge-reranker-v2-m3
# 本地模型目录（宿主侧路径，相对 deploy/ 或绝对路径）；
# 默认取仓库自带 agent/models（约 6.5GB，只读挂载，不进镜像）
AGENT_MODELS_DIR=../agent/models
# HuggingFace 国内镜像（无本地权重时的兜底下载源）
HF_ENDPOINT=https://hf-mirror.com

# --------------------------------------------------------------- mock MCP 面试工具（外部依赖）
# 邮件工具 9000 / 日历工具 9001 默认跑在宿主本机，容器内用 host.docker.internal 回连；
# Linux 引擎由 compose 的 extra_hosts: host-gateway 提供解析。
# 这两个服务不在本 compose 编排内，未启动时面试相关的 draft/send 会失败。
MCP_EMAIL_URL=http://host.docker.internal:9000
MCP_CALENDAR_URL=http://host.docker.internal:9001

# --------------------------------------------------------------- 时区
TZ=Asia/Shanghai
